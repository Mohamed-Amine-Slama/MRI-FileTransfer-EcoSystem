# Application configuration template (BUILD_SPEC P1.6).
#
# Copy to `.env` for local development:  cp .env.example .env
# `.env` is gitignored. This file is committed and must NEVER contain a real
# secret — it is a list of names, not values.
#
# In dev/staging/production these variables are injected from AWS Secrets
# Manager (BUILD_SPEC §6). There is no `.env` file on a deployed host.
#
# The API refuses to boot if any required variable is missing or invalid, and
# reports every problem at once.

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- database --------------------------------------------------------------
# MUST be the non-superuser application role. It must NOT have BYPASSRLS
# (ADR-6, P3.2), and must not own the tables it queries (P4.4 audit
# immutability). There is deliberately no admin/bypass connection string.
DATABASE_URL=postgresql://mir_app:change-me@localhost:5432/mir
DATABASE_POOL_MAX=10

# --- cache / queue ---------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- identity (P4.1) -------------------------------------------------------
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/mir
KEYCLOAK_AUDIENCE=mir-api
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/mir/protocol/openid-connect/certs

# --- self-service sign-up (§5.1) -------------------------------------------
# OPTIONAL. Unset, POST /auth/register answers 501 and the sign-up form says
# "self-registration is not enabled in this environment" — the deliberate
# behaviour for a deployment that provisions accounts out of band.
#
# Set them to a Keycloak client with `serviceAccountsEnabled` and the
# realm-management roles manage-users, view-users, query-users, view-realm.
# For local development `node scripts/dev-bootstrap.mjs` creates exactly that
# client and prints the two values to paste here.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Only needed where the admin API is reached at a different address than the
# issuer names — under docker compose the issuer must say `localhost` so it
# matches the `iss` in a browser-obtained token, and `localhost` inside the API
# container is that container. compose sets this to http://keycloak:8080.
KEYCLOAK_ADMIN_URL=

# --- web sign-in form (apps/web) -------------------------------------------
# Read at RUNTIME by apps/web/app/auth/password-login/route.ts, which relays
# the email+password form to Keycloak's token endpoint. The app never stores
# or checks a password: policy, lockout and brute-force protection stay in
# Keycloak (P4.1). The OIDC redirect remains the production path.
#
# The route derives the token endpoint from KEYCLOAK_ISSUER_URL above.
# KEYCLOAK_TOKEN_URL overrides it for split-horizon setups where the web
# server reaches Keycloak at an internal address while the issuer stays the
# browser-visible one (docker-compose sets exactly this pair). Overriding it
# requires the issuer to be pinned on Keycloak (KC_HOSTNAME), or the minted
# token's `iss` will not match what the API validates.
KEYCLOAK_TOKEN_URL=
KEYCLOAK_WEB_CLIENT_ID=mir-web

# --- object storage (P2.4) -------------------------------------------------
# Region per DECISION D5: Milan primary, Paris fallback/DR.
AWS_REGION=eu-south-1
S3_BUCKET_ORIGINALS=mir-dev-dicom-originals
S3_BUCKET_DERIVED=mir-dev-derived
S3_BUCKET_AUDIT_LOGS=mir-dev-audit-logs

# --- DICOM server (P8.1) ---------------------------------------------------
# Orthanc is private to the VPC. The browser never talks to it directly (P8.2).
ORTHANC_URL=http://localhost:8042
ORTHANC_USERNAME=mir-api
ORTHANC_PASSWORD=change-me

# --- upload (P7) -----------------------------------------------------------
# 5 MiB default. Libyan uplinks are slow and intermittent; smaller chunks mean
# less lost work per dropped connection, at the cost of more round trips.
UPLOAD_CHUNK_SIZE_BYTES=5242880
UPLOAD_SESSION_TTL_HOURS=72

# --- signed URLs (P8.2) ----------------------------------------------------
# Spec requires 5-15 minutes; values outside that range are rejected at boot.
SIGNED_URL_TTL_SECONDS=600

# --- scheduling (DECISION D3) ----------------------------------------------
# false = Tunisian doctor sees imaging only after payment succeeds.
# Consent is required in BOTH modes. This never bypasses consent.
CASES_QUOTE_TTL_MINUTES=30
CASES_ANSWER_WINDOW_HOURS=72

# --- billing (DECISION D2) -------------------------------------------------
# Authorise at booking, capture on acceptance. Uncaptured authorisations
# expire after this window and the slot is released.

# --- retention (BLOCKING L5 — placeholder values) --------------------------
# Counsel has NOT yet answered the retention question for Libya and Tunisia.
# These are placeholders. Object Lock retention on the originals bucket must be
# set to match whatever L5 concludes, and Object Lock retention cannot be
# shortened after the fact — do not guess low, and do not guess high either.
IMAGING_RETENTION_DAYS=3650
AUDIT_RETENTION_DAYS=3650

# --- consent (BLOCKING L4) -------------------------------------------------
CONSENT_TERMS_VERSION=v1

# --- local storage (development only) --------------------------------------
# Root for the filesystem BlobStore. Ignored outside development: the app
# refuses to start in staging/production without a real S3-backed store,
# because originals on a container filesystem are one restart from being lost.
LOCAL_STORAGE_ROOT=/tmp/mir-storage

# --- signed URLs (P8.2) ----------------------------------------------------
# Dedicated HMAC key for image URL signing, >=32 chars. From Secrets Manager in
# deployed environments. Rotating this invalidates in-flight image URLs only.
SIGNED_URL_SECRET=change-me-local-dev-only-at-least-32-chars

# --- billing (DECISION D2a: Stripe) ----------------------------------------
# From AWS Secrets Manager in deployed environments. Optional locally: without
# them the billing module refuses to authorise rather than failing mid-payment.
# BLOCKING L7: the receiving entity's jurisdiction is unresolved — Stripe
# requires the business to be established in a country it supports.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENT_CURRENCY=TND
