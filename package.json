{
  "name": "mir",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-border medical imaging transfer platform (Libya -> Tunisia)",
  "engines": {
    "node": ">=20.0.0 <25"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @mir/web test:e2e",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps/api/src",
    "boundaries:verify": "node scripts/verify-boundary-enforcement.mjs",
    "scan:verify": "node scripts/verify-dependency-scanning.mjs",
    "scan:unwired": "node scripts/find-unwired.mjs",
    "verify:mfa": "node scripts/verify-keycloak-mfa.mjs",
    "drill:restore": "node scripts/drill-restore.mjs",
    "verify:object-lock": "node scripts/verify-object-lock.mjs",
    "boundaries:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot apps/api/src",
    "check:synthetic": "node test-data/check-synthetic.mjs",
    "gen:fixtures": "node test-data/generate-fixtures.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "verify": "pnpm check:synthetic && pnpm typecheck && pnpm lint && pnpm boundaries && pnpm boundaries:verify && pnpm test && pnpm build && pnpm check:bundle",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "db:clean": "node scripts/clean-test-databases.mjs",
    "verify:gates": "node scripts/verify-gates.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "globals": "^15.14.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.2.0",
      "body-parser": "^1.20.6",
      "qs": "^6.15.2",
      "postcss": "^8.5.23",
      "sharp": "^0.35.4",
      "js-yaml@3": "^3.15.1",
      "@babel/runtime": "^7.26.10",
      "file-type": "^21.3.2",
      "uuid": "^11.1.1",
      "vite": "^6.4.3",
      "adm-zip": "^0.6.0"
    }
  }
}
