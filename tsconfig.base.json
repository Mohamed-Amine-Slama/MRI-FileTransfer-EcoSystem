{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // TypeScript 6 deprecates node10 resolution and baseUrl; they stop working in
    // 7.0. Moving to node16/node20 changes how the API emits dynamic import()
    // (native import instead of require), which touches the BullMQ/ioredis worker
    // at runtime — a migration of its own, not part of a compiler bump.
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "module": "commonjs",

    // BUILD_SPEC P1.1 requires both of these. Do not relax either one.
    // noUncheckedIndexedAccess is what stops `files[0]` being silently typed as
    // present when a DICOM series is empty.
    "strict": true,
    "noUncheckedIndexedAccess": true,

    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "pretty": true
  },
  "exclude": ["node_modules", "dist", ".next"]
}
