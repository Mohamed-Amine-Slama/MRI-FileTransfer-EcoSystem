{
  "name": "@mir/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:up": "tsx src/shared/db/migrate-cli.ts up",
    "migrate:down": "tsx src/shared/db/migrate-cli.ts down",
    "migrate:reset": "tsx src/shared/db/migrate-cli.ts reset"
  },
  "dependencies": {
    "@mir/contracts": "workspace:*",
    "@mir/dicom-utils": "workspace:*",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@types/pg": "^8.23.1",
    "bullmq": "^6.3.4",
    "dicom-parser": "^1.8.21",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
